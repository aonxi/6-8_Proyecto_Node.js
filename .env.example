# Puerto utilizado por el servidor Express
PORT=3000

# Configuración de conexión a PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=proyecto_backend
DB_USER=postgres
DB_PASSWORD=

# Secreto utilizado para firmar y verificar los tokens JWT.
JWT_SECRET=

# Tiempo de validez de los tokens JWT.
JWT_EXPIRES_IN=1h